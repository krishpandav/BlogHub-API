# Database
MONGO_URI=mongodb://localhost:27017/blog_website
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/blog_website

# JWT Secret (Change this to a strong secret)
JWT_SECRET=your_super_secret_jwt_key_here_change_this_in_production

# Server
PORT=5000
NODE_ENV=development

# File Upload (if using file upload)
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880